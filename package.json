{
  "name": "qarzname-ipad",
  "version": "1.0.0",
  "description": "سیستەمی تۆمارکردنی قەرز بۆ ئایپاد — قەرزنامە",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "icons:generate": "node scripts/generate-icons.js",
    "cap:sync": "STATIC_EXPORT=true CAP_BUILD=true npm run build && npx cap sync",
    "cap:sync:ios": "STATIC_EXPORT=true CAP_BUILD=true npm run build && npx cap sync ios",
    "cap:open:ios": "npx cap open ios",
    "ios:prepare": "npm run icons:generate && npm run cap:sync:ios"
  },
  "dependencies": {
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.475.0",
    "next": "^15.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.0",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0"
  },
  "capacitor": {
    "platforms": ["ios"]
  }
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// تێبینییەکی شوێنگرێدراو — بە کامێرا و GPS و نیشانەی بینراو لنگر دەکرێت
model SpatialNote {
  id           String   @id @default(cuid())
  title        String
  content      String   @db.Text
  latitude     Float
  longitude    Float
  accuracy     Float?
  altitude     Float?
  heading      Float?
  /// جیاوازی-هاش (dHash) وەک hex 16 کاراکتەر
  imageHash    String
  /// پرۆفایلی ڕەنگ (JSON) بۆ یارمەتیدانی ناسینەوە
  colorProfile String   @db.Text
  /// وێنەی بچووک base64 JPEG
  thumbnail    String?  @db.Text
  deviceId     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([deviceId])
  @@index([latitude, longitude])
  @@index([createdAt])
}

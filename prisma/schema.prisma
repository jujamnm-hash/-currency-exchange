generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VehicleType {
  SEDAN
  SUV
  TRUCK
  VAN
  MOTORCYCLE
  LUXURY
}

enum OrderStatus {
  WAITING
  CHECK_IN
  WASHING
  DRYING
  DETAILING
  QUALITY_CHECK
  READY
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE_PAYMENT
  MEMBERSHIP
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Service {
  id          String   @id @default(cuid())
  nameKu      String
  nameEn      String
  description String?
  basePrice   Float
  duration    Int
  category    String
  icon        String   @default("droplets")
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems       OrderItem[]
  appointmentItems AppointmentItem[]
  membershipPlans  MembershipPlan[]
}

model ServiceAddon {
  id        String   @id @default(cuid())
  nameKu    String
  nameEn    String
  price     Float
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  orderAddons OrderAddon[]
}

model VehiclePriceMultiplier {
  id          String      @id @default(cuid())
  vehicleType VehicleType @unique
  multiplier  Float       @default(1.0)
  labelKu     String
}

model Customer {
  id            String   @id @default(cuid())
  name          String
  phone         String   @unique
  email         String?
  loyaltyPoints Int      @default(0)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  vehicles     Vehicle[]
  orders       Order[]
  appointments Appointment[]
  memberships  Membership[]
}

model Vehicle {
  id           String      @id @default(cuid())
  customerId   String
  plateNumber  String
  vehicleType  VehicleType @default(SEDAN)
  make         String?
  model        String?
  color        String?
  year         Int?
  createdAt    DateTime    @default(now())

  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orders       Order[]
  appointments Appointment[]

  @@unique([customerId, plateNumber])
}

model Employee {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  role      String   @default("washer")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  orders Order[]
}

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique
  customerId    String?
  vehicleId     String?
  employeeId    String?
  vehicleType   VehicleType   @default(SEDAN)
  plateNumber   String
  customerName  String?
  customerPhone String?
  status        OrderStatus   @default(WAITING)
  subtotal      Float         @default(0)
  discount      Float         @default(0)
  tax           Float         @default(0)
  total         Float         @default(0)
  notes         String?
  queuePosition Int?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  customer  Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  vehicle   Vehicle?    @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  employee  Employee?   @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  items     OrderItem[]
  addons    OrderAddon[]
  payment   Payment?
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  serviceId String
  price     Float
  quantity  Int    @default(1)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id])
}

model OrderAddon {
  id      String @id @default(cuid())
  orderId String
  addonId String
  price   Float

  order Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  addon ServiceAddon @relation(fields: [addonId], references: [id])
}

model Payment {
  id        String        @id @default(cuid())
  orderId   String        @unique
  amount    Float
  method    PaymentMethod @default(CASH)
  status    PaymentStatus @default(PENDING)
  paidAt    DateTime?
  createdAt DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Appointment {
  id            String            @id @default(cuid())
  customerId    String
  vehicleId     String?
  scheduledAt   DateTime
  status        AppointmentStatus @default(SCHEDULED)
  notes         String?
  estimatedTotal Float            @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  customer Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicle  Vehicle?          @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  items    AppointmentItem[]
}

model AppointmentItem {
  id            String @id @default(cuid())
  appointmentId String
  serviceId     String
  price         Float

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id])
}

model MembershipPlan {
  id           String   @id @default(cuid())
  nameKu       String
  nameEn       String
  serviceId    String?
  washesCount  Int
  price        Float
  validityDays Int      @default(30)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  service     Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  memberships Membership[]
}

model Membership {
  id           String   @id @default(cuid())
  customerId   String
  planId       String
  washesUsed   Int      @default(0)
  washesTotal  Int
  startDate    DateTime @default(now())
  endDate      DateTime
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  customer Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  plan     MembershipPlan @relation(fields: [planId], references: [id])
}

model InventoryItem {
  id           String   @id @default(cuid())
  nameKu       String
  nameEn       String
  quantity     Float
  unit         String   @default("liter")
  minQuantity  Float    @default(5)
  lastRestocked DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model DailyReport {
  id              String   @id @default(cuid())
  date            DateTime @unique @db.Date
  totalOrders     Int      @default(0)
  completedOrders Int      @default(0)
  totalRevenue    Float    @default(0)
  cashRevenue     Float    @default(0)
  cardRevenue     Float    @default(0)
  avgWaitTime     Int?
  createdAt       DateTime @default(now())
}

model Settings {
  id    String @id @default("main")
  key   String @unique
  value String
}
